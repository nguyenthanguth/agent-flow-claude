{
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "tsx watch server/src/main.ts --no-open --verbose",
    "dev:web": "pnpm --filter agent-flow-claude-web run dev",
    "dev:demo": "pnpm --filter agent-flow-claude-web run dev -- --open /?demo",
    "build": "node server/build.js",
    "start": "node server/dist/agent-flow-claude.js",
    "test": "node --import tsx --test \"server/test/**/*.test.ts\" \"web/hooks/**/*.test.ts\" \"web/lib/**/*.test.ts\"",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22",
    "concurrently": "^9.2.1",
    "esbuild": "^0.20.2",
    "tsx": "^4.21.0",
    "typescript": "5.7.3"
  }
}
